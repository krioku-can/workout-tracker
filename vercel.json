{
  "functions": {
    "api/workout.js": { "memory": 256, "maxDuration": 10 },
    "api/operator.js": { "memory": 256, "maxDuration": 10 }
  },
  "rewrites": [
    { "source": "/api/operator", "destination": "/api/operator" },
    { "source": "/api/(.*)", "destination": "/api/workout" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
